root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space

[*.md]
indent_size = 4
trim_trailing_whitespace = false

[{*.html,*.css,*.js}]
indent_size = 2

[*.nix]
indent_size = 2

[{*.sh,*.zsh}]
indent_size = 2

[{*.json,*.jsonc,*.yml,*.yaml,*.toml}]
indent_size = 2

[*.kdl]
indent_size = 4
